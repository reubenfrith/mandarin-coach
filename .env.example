# Copy this to .env and fill in your values — never commit .env
# Keep comments on their OWN lines (an inline comment after a value can be
# parsed as part of the value by python-dotenv).

# Required: routes all LLM calls through OpenRouter
OPENROUTER_API_KEY=

# Required for login: a random secret that signs auth tokens.
# Generate one with:  uv run chainlit create-secret   (or any long random string)
CHAINLIT_AUTH_SECRET=

# Optional: OpenAI embeddings baseline. If unset, the app falls back to a local
# embedding model, so the app still runs without this key. (Voice does NOT need an
# OpenAI key — it runs through OpenRouter, below.) NOTE: if you already have a
# corpus built with the LOCAL model and then set this key, embeddings silently
# switch spaces and degrade retrieval — pin EMBEDDING_MODEL=default in that case.
OPENAI_API_KEY=

# Voice Conversation Partner — turn-based STT -> LLM -> TTS through OpenRouter (uses
# OPENROUTER_API_KEY above; no OpenAI key needed). Slugs overridable; if one is
# rejected, correct it against https://openrouter.ai/models .
# CONVERSATION_MODEL=glm                     # MODELS key used to converse (fast, non-hanging)
# STT_MODEL=openai/gpt-4o-mini-transcribe
# TTS_MODEL=openai/gpt-4o-mini-tts
# TTS_VOICE=alloy
# VOICE_MIN_STT_CONFIDENCE=0.6               # gate; OpenRouter STT gives no confidence, so unused for now

# Optional: agentic web search tool
TAVILY_API_KEY=

# Optional: LangSmith tracing/monitoring
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
# Trace project name. Defaults to "mandarin-coach" for the app and
# "mandarin-coach-evals" for eval runs, so evaluation traffic stays separate.
# LANGSMITH_PROJECT=mandarin-coach

# Optional reliability tuning (seconds). REQUEST_TIMEOUT caps each LLM call;
# AGENT_TURN_TIMEOUT hard-bounds a whole agent turn before falling back to the
# fast model (deepseek, a reasoning model, occasionally hangs many minutes).
# REQUEST_TIMEOUT=90
# AGENT_TURN_TIMEOUT=180
