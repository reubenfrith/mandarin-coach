# Copy this to .env and fill in your values — never commit .env
# Keep comments on their OWN lines (an inline comment after a value can be
# parsed as part of the value by python-dotenv).

# Required: routes all LLM calls through OpenRouter
OPENROUTER_API_KEY=

# Required for login: a random secret that signs auth tokens.
# Generate one with:  uv run chainlit create-secret   (or any long random string)
CHAINLIT_AUTH_SECRET=

# OpenAI key. Used for two things:
#   1. Embeddings baseline (optional — the app falls back to a local embedding
#      model without it). NOTE: if you already have a corpus built with the LOCAL
#      model and then set this key, embeddings silently switch spaces and degrade
#      retrieval — pin EMBEDDING_MODEL=default in that case (or re-embed).
#   2. The voice Conversation Partner (REQUIRED for voice, and the key must be
#      entitled for the OpenAI Realtime API — this is separate from OPENROUTER).
OPENAI_API_KEY=

# Voice Conversation Partner (OpenAI Realtime API). Overridable if OpenAI renames
# the model/voice; the session-create error lists valid names if a slug is rejected.
# REALTIME_MODEL=gpt-realtime-2.1
# REALTIME_VOICE=marin
# Min speech-to-text confidence (0-1) for a voice turn to be eligible for error
# logging; below this the transcript is likely mis-heard and is skipped.
# VOICE_MIN_STT_CONFIDENCE=0.6

# Optional: agentic web search tool
TAVILY_API_KEY=

# Optional: LangSmith tracing/monitoring
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
# Trace project name. Defaults to "mandarin-coach" for the app and
# "mandarin-coach-evals" for eval runs, so evaluation traffic stays separate.
# LANGSMITH_PROJECT=mandarin-coach

# Optional reliability tuning (seconds). REQUEST_TIMEOUT caps each LLM call;
# AGENT_TURN_TIMEOUT hard-bounds a whole agent turn before falling back to the
# fast model (deepseek, a reasoning model, occasionally hangs many minutes).
# REQUEST_TIMEOUT=90
# AGENT_TURN_TIMEOUT=180
